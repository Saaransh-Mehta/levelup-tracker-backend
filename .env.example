PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Password-reset emails (https://resend.com). Without a key, reset links are printed to the log.
RESEND_API_KEY=
# Sender address; needs a domain verified in Resend. onboarding@resend.dev only reaches your own Resend email.
EMAIL_FROM=LevelUp <onboarding@resend.dev>
# Where reset links point
APP_URL=https://levelup-tracker-frontend.vercel.app
# Sites allowed to call the API, comma-separated (defaults to the Vercel frontend and localhost)
CORS_ORIGINS=
